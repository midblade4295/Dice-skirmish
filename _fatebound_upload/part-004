    ctx.fillStyle='#fff'; ctx.font='900 10px Nunito, sans-serif'; ctx.textAlign='center'; ctx.fillText(`${fmtK(G.hp)} / ${fmtK(G.max)}`, x + bw/2, y + 9.5);
    ctx.textAlign = s===0 ? 'left' : 'right'; ctx.fillStyle='#78b7ff'; ctx.fillText(G.up.length ? `🛡 ${fmtK(G.up.reduce((n,h)=>n+shieldCapacity(h),0))} absorb · ${G.up.length}/${G.list.length} up` : (G.list.length ? `WIPED · back in ${Math.max(0, Math.ceil((Math.min(...G.list.map(h=>h.downUntil||0)) - Date.now())/1000))}s${s===1 ? ' · SIEGE' : ''}` : 'no garrison'), s===0 ? x : x + bw, y + bh + 12);
  });
}
