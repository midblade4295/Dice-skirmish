  const im = SPR[key], m = SPR_META[key], k = (78*sl.s)/SPR_HEXW * (key==='scaffold' ? 0.62 : 1) * 1.15, x = 200, y = sl.y + 8;
  const age=performance.now()-(T.sieged||0);
  const sg = T.sieged&&age>=0&&age<300 ? 1-age/300 : 0, jx = sg ? (Math.random()-0.5)*6*sg : 0;
  if (im && im.complete && im.naturalWidth) ctx.drawImage(im, x - m.ax*k + jx, y - m.ay*k, m.w*k, m.h*k);
  if(sg){ctx.save();ctx.globalAlpha=sg*.65;ctx.strokeStyle='#ffe291';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(x,y+2,12+12*(1-sg),5+4*(1-sg),0,0,Math.PI*2);ctx.stroke();ctx.restore();}
