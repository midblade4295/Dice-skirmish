  [[0, 12, '#37c0dd', 'YOUR GARRISON'], [1, W - 12 - bw, '#e8702f', 'ENEMY GARRISON']].forEach(([s, x, col, name])=>{
    const G = garrison(T.id, s), pct = G.max ? G.hp/G.max : 0, hitRecently = G.list.some(h=>h.hitAt && now >= h.hitAt && now - h.hitAt < 200);
    ctx.fillStyle='rgba(10,16,21,.82)'; roundRect(x - 4, y - 16, bw + 8, bh + 34, 7); ctx.fill();
