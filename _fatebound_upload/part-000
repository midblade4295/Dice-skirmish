<script>
// ---------- rules.js (shared with the server in M1) ----------
// Six symbols, two faces each on every d12. Match-3: a pair triggers the action, a triple upgrades it (Model C).
const R = {
  FACES: ['S','S','C','C','H','H','G','G','F','F','E','E'],
  get ENERGY_CAP(){ return SAVE.cap || 50; }, REGEN_MS: 10*60*1000,
  OVERTIME_MS: 60000, HEAT_BUFF_AT: 5, HEAT_HOT_AT: 10, HOLD_MS: 650, LOOT_CHANCE: 0.15, SIEGE: 1.2, BREACH: 0.15,   // siege: attacks on a wiped garrison hit the tower score at 120% (undefended walls); breach: wiping a garrison banks 15% of its max HP as tower damage
  HP_MULT: 60, KO_MS: 45000, RESPAWN_SHIELDS: 0, MAX_SHIELDS: 3,
  UNITS: { none:1, pair:2, triple:5 }, SPLASH: 0.25,
  GOLD: { none:5, pair:25, triple:200 }, ENERGY: { pair:1, triple:5 },
  RALLY_MS: 60000, RALLY_STEP: 0.1, RALLY_CAP: 2, RALLIES: 2, RALLY_CD_MS: 180000,
  BOT_ROLLS_PER_MIN: 60, PER_TOWER: 2,     // each guild's bots roll about once a second between them, so a 30-minute war is six times a 5-minute one
  atk(level){ return 10 + 2*level; },
  hp(level){ return R.HP_MULT * R.atk(level); },
  critMult(level){ return 2 + Math.min(3,0.1*level); },
  xpNeed(level){ return 60 + 30*level; },
  TRIPLE_CHANCE: .15, PAIR_CHANCE: .55,
  rollFaces(rng){
    const symbols=['S','C','H','G','E','F'], bucket=rng();
    const take=()=>symbols.splice(Math.floor(rng()*symbols.length),1)[0];
    const first=take();let faces;
    if(bucket<R.TRIPLE_CHANCE)faces=[first,first,first];
    else if(bucket<R.TRIPLE_CHANCE+R.PAIR_CHANCE)faces=[first,first,take()];
    else faces=[first,take(),take()];
    for(let i=2;i>0;i--){const j=Math.floor(rng()*(i+1));[faces[i],faces[j]]=[faces[j],faces[i]];}
    return faces;
  },
  resolve(faces){
    const c = {S:0,C:0,H:0,G:0,F:0,E:0}; faces.forEach(f=>c[f]++);
    const sym = Object.keys(c).find(k=>c[k]===3) || Object.keys(c).find(k=>c[k]===2) || null;
    const tier = sym ? (c[sym]===3 ? 'triple' : 'pair') : 'none';
    const action = sym || (c.S ? 'S' : (c.G ? 'G' : null));
    return { action, tier, sym, faces, crit: action==='C', splash: action==='C' && tier==='triple',
             units: (action==='S' || action==='C') ? R.UNITS[tier] : 0,
             gold: action==='G' ? R.GOLD[tier] : 0, energy: action==='E' ? R.ENERGY[tier] : 0,
             shield: action==='H' ? tier : null, gift: action==='F' ? (tier==='triple' ? 3 : 1) : 0 };
  }
};
// ten towers in three sections: outposts I–V (1 pt), training camp VI–VIII (2 pts), castle courtyard IX–X (3 pts) — 17 on the map.
// Each side posts two defenders per tower, strongest at the top; you roam.
const TOWER_DEF = [ ['I',1],['II',1],['III',1],['IV',1],['V',1],['VI',2],['VII',2],['VIII',2],['IX',3],['X',3] ];
const SECTION_OF = i => i>=8 ? 'Courtyard' : i>=5 ? 'Training camp' : 'Outposts';

// ---------- state ----------
const $ = id => document.getElementById(id);
const reduced = false;
const rng = Math.random;
const NAMES = ['Aldric','Bram','Cass','Dorn','Elka','Fenn','Gault','Hesper','Ivo','Jory','Kell','Lira','Marek','Nessa','Oswin','Pike','Quill','Rook','Sable','Tarn','Ulf','Vesna','Wyn','Yara','Zed','Orla','Bryn','Corwin','Dagny','Emrys','Falk','Greer','Hollis','Idris','Jem','Kit','Lowen','Maud','Niall','Ottilie'];
let M = null, player = null, anim = null, floats = [], lastPick = 5, screen = 'map';
const feedLog = [];

// ---------- save: everything that persists on this device ----------
// character, weapons, gold, hero level + xp, energy clock, lifetime stats, rank, daily quests, login streak, held chests, pending gifts, rival
const SAVE_DEF = () => ({ char:0, owned:[0], weapon:0, gold:0, level:5, xp:0, cap:50, energyAt:0,
  stats:{ matches:0, wins:0, bestDmg:0, bestKos:0, bestTriples:0, damage:0, kos:0, triples:0, rolls:0, flips:0 },
  rank:0, ladder:null, daily:{ date:'', q:[], p:{}, done:[] }, login:{ date:'', streak:0 }, chests:[], giftsDue:[], rival:null, tokens:0, relics:{ cap:0, atk:0, crit:0, lucky:0 }, boss:null, bossPending:null, bonus:0, season:{ id:0, pts:0, free:[], prem:[], premium:false }, tiers:{}, shards:{ steel:0, arcane:0, fletch:0 } });
let SAVE = SAVE_DEF();
try { const j = localStorage.getItem('fatebound-save'); if (j){ const o = JSON.parse(j); if (o && Array.isArray(o.owned)){ const d = SAVE_DEF(); SAVE = Object.assign({}, d, o); SAVE.owned = SAVE.owned.filter(i=>i>=0 && i<9); if (!SAVE.owned.includes(0)) SAVE.owned.unshift(0); if (!SAVE.owned.includes(SAVE.weapon)) SAVE.weapon = 0; if (SAVE.char>4) SAVE.char = 0; SAVE.stats = Object.assign(d.stats, o.stats||{}); SAVE.daily = Object.assign(d.daily, o.daily||{}); SAVE.login = Object.assign(d.login, o.login||{}); SAVE.relics = Object.assign(d.relics, o.relics||{}); SAVE.season = Object.assign(d.season, o.season||{}); SAVE.tiers = Object.assign({}, o.tiers||{}); SAVE.shards = Object.assign(d.shards, o.shards||{}); } } } catch(_){}
let economyDepth=0,saveErrorShown=false;
var TRAIN;
function persist(){
  if(TRAIN){trainingPersist();return true;}
  if(economyDepth)return true;
  try {if(M?.campaign&&SAVE.war?.model===2){SAVE.war.snapshot=JSON.parse(JSON.stringify(M));SAVE.war.playerId=player.id;}localStorage.setItem('fatebound-save',JSON.stringify(SAVE));return true;}
  catch(error){if(!saveErrorShown){saveErrorShown=true;setTimeout(()=>alert('Progress could not be saved. Please free browser storage before continuing.'),0);}return false;}
}
function economyLog(kind,amount){SAVE.economyLog ||= [];SAVE.economyLog.push({at:Date.now(),kind,amount,mode:M?.inBoss?'boss':'war',mult:player?.action?.mult||1,free:player?.action?.free||false});if(SAVE.economyLog.length>200)SAVE.economyLog.splice(0,SAVE.economyLog.length-200);}
function economyDay(){const date=new Date().toDateString();if(!SAVE.economyDay||SAVE.economyDay.date!==date)SAVE.economyDay={date,matchEnergy:0,botEnergy:0,returnEnergy:0,freeGift:false};return SAVE.economyDay;}
function atomicEconomy(fn){
  if(economyDepth)return fn();
  const before=JSON.stringify(SAVE),hero=player?{gold:player.gold,xp:player.xp,level:player.level,energyAt:player.energyAt,atk:player.atk,hp:player.hp,maxHp:player.maxHp}:null;
  economyDepth++;
  try {const result=fn();economyDepth--;if(!persist())throw Error('Save failed');return result;}
  catch(error){economyDepth=0;SAVE=JSON.parse(before);if(hero)Object.assign(player,hero);throw error;}
}
function recalcHero(h){const C=CHARS[h.char],ratio=h.hp/h.maxHp;h.atk=Math.round(R.atk(h.level)*C.atk*(h===player?1+.02*(SAVE.relics.atk||0):1));h.maxHp=Math.round(R.hp(h.level)*C.hp);if(h.hp>0)h.hp=Math.round(h.maxHp*ratio);}
function makeChest(mult=1){return {level:player.level,mult,kind:shardKindOf(player.weapon)};}
function grantChest(r){gainGold(player,r.gold);addShards(r.kind,r.shards,'Chest reward');}
function recoverEconomyRewards(){
  if(!SAVE.pendingMatch)return;
  atomicEconomy(()=>{const rw=SAVE.pendingMatch;SAVE.pendingMatch=null;gainGold(player,rw.gold);addEnergy(rw.energy);if(rw.season===seasonId())seasonAdd(rw.pts);if(rw.shards)SAVE.shards[rw.kind]=(SAVE.shards[rw.kind]||0)+rw.shards;});
}
function normalizeSave(){
  SAVE.schema=2;
  if(SAVE.pendingRoll){SAVE.bonus=(SAVE.bonus||0)+Math.max(0,SAVE.pendingRoll.paid||0);SAVE.pendingRoll=null;}
  const d=SAVE_DEF();
  for(const k of ['stats','relics','shards'])for(const [field,value]of Object.entries(d[k]))if(typeof value==='number'&&(!Number.isFinite(SAVE[k][field])||SAVE[k][field]<0))SAVE[k][field]=value;
  for(const k of ['gold','xp','bonus','tokens','rank','energyAt'])if(!Number.isFinite(SAVE[k])||SAVE[k]<0)SAVE[k]=d[k]||0;
  SAVE.level=Math.max(1,Math.floor(Number(SAVE.level)||5));
  SAVE.char=Math.max(0,Math.min(4,Math.floor(Number(SAVE.char)||0)));
  for(const k of ['chests','giftsDue'])if(!Array.isArray(SAVE[k]))SAVE[k]=[];
  for(const k of ['damageGifts','allyProgress','allyRolls'])if(!SAVE[k]||typeof SAVE[k]!=='object')SAVE[k]={};
  SAVE.giftsDue.forEach((g,i)=>{g.id ||= `legacy-${g.at}-${i}`;});
  if(SAVE.pendingOpenChest){SAVE.chests.push(SAVE.pendingOpenChest);SAVE.pendingOpenChest=null;}
}
normalizeSave();

// ---------- daily quests + login streak ----------
const DAILY_POOL = [
  { k:'shieldsBroken', need:10, d:'Break 10 shields', r:{gold:300} },
  { k:'kos', need:3, d:'Knock out 3 enemies', r:{gold:400} },
  { k:'triples', need:2, d:'Roll 2 triples', r:{energy:5} },
  { k:'rolls', need:40, d:'Roll 40 times', r:{gold:250} },
  { k:'damage', need:4000, d:'Deal 4,000 damage', r:{gold:500} },
  { k:'gifts', need:2, d:'Gift 2 guildmates', r:{energy:5} },
  { k:'flips', need:1, d:'Flip a tower', r:{gold:600} },
  { k:'wins', need:1, d:'Win a battle', r:{energy:10} },
  { k:'bounties', need:1, d:'Collect a bounty', r:{gold:500} },
];
const dayKey = () => new Date().toDateString();
function dailyRoll(){
  const today = dayKey(); if (SAVE.daily.date === today && SAVE.daily.q.length) return;
  let h = 0; for (const ch of today) h = (h*31 + ch.charCodeAt(0)) >>> 0;
  const idx = []; while (idx.length < 3){ h = (h*1103515245 + 12345) >>> 0; const i = h % DAILY_POOL.length; if (!idx.includes(i)) idx.push(i); }
  SAVE.daily = { date: today, q: idx, p:{}, done:[] }; persist();
}
function dailyAdd(k, n){
  dailyRoll(); const D = SAVE.daily; D.p[k] = (D.p[k]||0) + n;
  D.q.forEach(i=>{ const q = DAILY_POOL[i]; if (q.k!==k || D.done.includes(i) || (D.p[k]||0) < q.need) return;
    D.done.push(i); if (q.r.gold) gainGold(player, q.r.gold); if (q.r.energy) addEnergy(q.r.energy); seasonAdd(3);
    toast(`Daily done: ${q.d} — +${q.r.gold ? q.r.gold+' gold' : q.r.energy+' energy'}`); SFX.level(); feed(`Daily quest complete: ${q.d}`, 'rally'); });
  persist();
}
function dailyText(){ dailyRoll(); const D = SAVE.daily; return D.q.map(i=>{ const q = DAILY_POOL[i], p = Math.min(q.need, Math.round(D.p[q.k]||0)), done = D.done.includes(i); return { q, p, done }; }); }
function msToMidnight(){ const d = new Date(); d.setHours(24,0,0,0); return d - Date.now(); }
function capNow(){ return 50 + 5*Math.min(10, Math.max(0, SAVE.login.streak - 1)) + 2*(SAVE.relics.cap||0); }
function loginTick(){
  const today = dayKey(); if (SAVE.login.date === today) return null;
  const y = new Date(); y.setDate(y.getDate()-1);
  SAVE.login.streak = SAVE.login.date === y.toDateString() ? SAVE.login.streak + 1 : 1; SAVE.login.date = today;
  const oldCap=SAVE.cap||50,oldPool=Math.max(0,oldCap-Math.ceil(Math.max(0,(SAVE.energyAt||0)-Date.now())/R.REGEN_MS));
  SAVE.cap = Math.max(oldCap,capNow());
  const bonus = 5 + 2*Math.min(10, SAVE.login.streak);   // day 1: 7, day 10+: 25
  const total=oldPool+bonus, pool=Math.min(SAVE.cap,total);SAVE.bonus=(SAVE.bonus||0)+Math.max(0,total-SAVE.cap);SAVE.energyAt=Date.now()+(SAVE.cap-pool)*R.REGEN_MS;if(player)player.energyAt=SAVE.energyAt;persist();
