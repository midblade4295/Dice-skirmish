<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Fatebound</title>
<meta name="fatebound-build" content="90-balanced">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0a1015">
<link rel="manifest" href='data:application/manifest+json,{"name":"Fatebound","short_name":"Fatebound","display":"fullscreen","orientation":"portrait","background_color":"%230a1015","theme_color":"%230a1015","start_url":"."}'>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --sky:#1f4652; --panel:#101a22; --panel-2:#1b2a35; --line:#2d4250; --text:#f4efe4; --muted:#a9b6bf;
  --gold:#f2b632; --gold-deep:#c98a12; --gold-dark:#7a4f06; --teal:#37c0dd; --orange:#e8702f; --green:#7ee04c;
  --gem:#3ecf6a; --bolt:#3aa8ff; --shield:#78b7ff;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --panel:#101a22; --text:#f4efe4; } }
:root[data-theme="dark"]{ --panel:#101a22; --text:#f4efe4; }
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:#0a1015}
:fullscreen #app,:-webkit-full-screen #app{height:100vh}
body{background:var(--panel);color:var(--text);font-family:"Nunito",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-weight:800;font-size:16px;line-height:1.2;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;overscroll-behavior:none}
#app{width:100%;margin:0 auto;height:100%;height:100dvh;overflow:hidden;display:flex;flex-direction:column;background:var(--panel-2);
  padding-top:env(safe-area-inset-top)}
/* top HUD */
.hud{display:flex;align-items:center;gap:8px;padding:12px 10px 2px;background:linear-gradient(180deg,#0c141b,#15222c)}
.wallet{display:flex;align-items:center;gap:6px;padding:4px 10px 6px;background:#15222c}
.wallet .spacer{flex:1}
.pill{display:flex;align-items:center;gap:5px;background:#0a1015;border:2px solid #2d3d48;border-radius:11px;padding:2px 9px 2px 5px;font:inherit;font-weight:900;font-size:13px;color:#fff;cursor:pointer;min-width:0}
.pill svg{width:18px;height:18px;flex:none}.pill span{font-variant-numeric:tabular-nums}
.pill.gold{border-color:#7a4f06;color:#ffd94a}.pill.token{border-color:#7a1f1e;color:#ffb0a0}.pill.season{border-color:#5a2a8a;color:#e9c8ff}
.pill:active{transform:translateY(1px)}
.xp .lvrow{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:2px}.xp .lv{background:linear-gradient(180deg,#ffd94a,#e0a11c);color:#2a1608;font-size:10px;font-weight:900;letter-spacing:.06em;padding:1px 7px;border-radius:7px}.xp .xpn{font-size:11px;color:var(--muted);font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.avatar{position:relative;width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#f3c58a,#b97a48);border:3px solid #e9edf0;display:grid;place-items:center;color:#3a2412;font-size:20px;font-weight:900;flex:none}
.avatar{border:3px solid #e9edf0;cursor:pointer;font:inherit;font-weight:900}.avatar{overflow:visible}.avatar .ring{position:absolute;left:-7px;top:-7px;width:calc(100% + 14px);height:calc(100% + 14px);transform:rotate(-90deg);pointer-events:none}.avatar .ring circle{fill:none;stroke-width:5}.avatar .ring .bg{stroke:rgba(10,16,21,.8)}.avatar .ring .fg{stroke:#c98aff;stroke-linecap:round;stroke-dasharray:170;stroke-dashoffset:170;transition:stroke-dashoffset .3s}
.avatar.ready .ring .fg{stroke:#ffd94a;filter:drop-shadow(0 0 6px #ffd94a);animation:pulse .7s infinite}.avatar.ready{box-shadow:0 0 18px rgba(255,217,74,.8)}
.ultbtn{position:absolute;left:50%;top:-16px;transform:translateX(-50%);z-index:3;display:flex;align-items:center;gap:6px;padding:4px 12px 4px 8px;border:2px solid #ffd94a;border-radius:12px;background:linear-gradient(180deg,#3a1a5a,#1b0f2a);color:#fff;font:inherit;font-weight:900;cursor:pointer;box-shadow:0 0 18px rgba(201,138,255,.8),0 4px 0 #2a1040;animation:pulse .8s infinite}.ultbtn[hidden]{display:none}.ultbtn span{font-size:18px}.ultbtn b{font-size:13px;letter-spacing:.06em;color:#ffd94a}.ultbtn small{display:block;font-size:9px;color:#e9c8ff;font-weight:800}
.flash{position:fixed;inset:0;z-index:5;pointer-events:none;background:#fff;opacity:0}.flash.go{animation:flash .5s ease-out}@keyframes flash{0%{opacity:.85}100%{opacity:0}}
.avatar .dot{position:absolute;right:-6px;top:-6px;width:14px;height:14px;border-radius:50%;background:#c9302f;border:2px solid #15222c}.avatar .dot[hidden]{display:none}
.avatar b{position:absolute;left:-8px;bottom:-8px;background:#ffd94a;color:#3a2412;font-size:13px;padding:1px 7px;border-radius:9px;border:2px solid #15222c}
.xp{flex:1;min-width:0}
.xp .bar{height:10px;background:#0a1015;border-radius:6px;border:2px solid #2d3d48;position:relative;overflow:hidden}
.xp .bar i{position:absolute;inset:0;width:0%;background:linear-gradient(180deg,#ffd94a,#f2b632)}
.xp .bar span{position:relative;z-index:1;display:block;text-align:center;font-size:12px;line-height:14px;color:#fff;text-shadow:0 1px 2px #000}
.xp .bar.flash{animation:xpflash .35s ease-out}
@keyframes xpflash{0%{box-shadow:0 0 0 0 rgba(255,217,74,.9);border-color:#ffd94a}100%{box-shadow:0 0 14px 6px rgba(255,217,74,0);border-color:#2d3d48}}
.stat{display:flex;align-items:center;gap:5px;background:#0a1015;border:2px solid #2d3d48;border-radius:11px;padding:3px 8px 3px 5px;font-size:15px;white-space:nowrap}
.stat svg{width:20px;height:20px;flex:none}
.fsbtn{border:2px solid #2d3d48;background:#0a1015;color:#a9b6bf;border-radius:10px;width:30px;height:26px;cursor:pointer;flex:none;padding:0;display:grid;place-items:center}.fsbtn svg{width:16px;height:16px}.fsbtn.on{color:#7ee04c;border-color:#3a5060}
@media (display-mode: fullscreen), (display-mode: standalone){ .fsbtn{display:none} }
.stat{position:relative}
.stat .reg{position:absolute;left:0;right:0;top:-13px;text-align:center;font-size:10px;color:var(--green);font-weight:800;white-space:nowrap}
.stat .plus{width:18px;height:18px;border-radius:50%;background:var(--green);color:#0a1015;font-size:14px;line-height:18px;text-align:center;margin-left:2px}
/* score bar */
.score{display:grid;grid-template-columns:26px 1fr 26px;gap:8px;align-items:center;padding:2px 10px 4px;background:#15222c}
.banner{width:26px;height:36px;border-radius:0 0 6px 6px;position:relative;clip-path:polygon(0 0,100% 0,100% 100%,50% 82%,0 100%)}
.banner.l{background:linear-gradient(180deg,#e8702f,#a8451a)} .banner.r{background:linear-gradient(180deg,#c9302f,#8a1f1e)}
.banner::before{content:"";position:absolute;left:0;right:0;top:0;height:6px;background:#ffd94a}
.score .mid{position:relative}
.score .nums{display:flex;justify-content:space-between;font-size:19px;font-weight:900;padding:0 4px;line-height:1.1}
.score .nums .a{color:var(--teal)} .score .nums .b{color:var(--orange)}
.score .track{height:11px;border-radius:7px;background:var(--orange);overflow:hidden;border:2px solid #0a1015;margin-top:2px}
.score .track i{display:block;height:100%;background:var(--teal);width:50%;transition:width .4s}
.score .lead{position:absolute;left:50%;bottom:-4px;transform:translateX(-50%);background:#2d3d48;color:#fff;font-size:11px;padding:1px 7px;border-radius:8px;border:2px solid #0a1015}
.score .time{position:absolute;left:50%;transform:translateX(-50%);top:0;color:var(--green);font-size:15px;margin-top:0;font-variant-numeric:tabular-nums}
/* board */
.arena{position:relative;flex:1;min-height:0;background:#859653;overflow:hidden}
.arena canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
#board{touch-action:manipulation}
/* roll */
.rollbar{position:relative;display:grid;grid-template-columns:1fr auto 1fr;grid-template-rows:auto auto;align-items:center;gap:6px 8px;padding:8px 10px 7px;background:linear-gradient(180deg,#5b3a22,#3a2314)}
.ultbar{grid-column:1/-1;position:relative;height:20px;border:2px solid #5a2a8a;border-radius:10px;background:#1b0f2a;overflow:hidden;font:inherit;cursor:pointer;padding:0;color:#fff}
.ultbar .fill{position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(90deg,#7a3aa5,#c98aff);transition:width .3s}
.ultbar .lbl{position:relative;display:flex;align-items:center;justify-content:center;gap:6px;height:100%;font-size:10.5px;font-weight:900;letter-spacing:.08em;text-shadow:0 1px 0 #000}.ultbar .lbl i{font-style:normal}.ultbar .lbl em{font-style:normal;color:#e9c8ff}
.ultbar.ready{border-color:#ffd94a;box-shadow:0 0 14px rgba(255,217,74,.8);animation:pulse .7s infinite}.ultbar.ready .fill{background:linear-gradient(90deg,#ffd94a,#ff9a4a)}.ultbar.ready .lbl em{color:#2a1608}.ultbar.ready .lbl{color:#2a1608;text-shadow:none}
.ultbar.bump .fill{filter:brightness(1.6)}
.mults{justify-self:end;width:92px;border:2px solid #7a4f06;background:#2a1608;color:#e0c9a8;font:inherit;font-weight:900;border-radius:10px;padding:4px 6px 5px;cursor:pointer;display:grid;gap:2px;text-align:center}
.mults b{font-size:20px;line-height:1;color:#ffd94a}
.mults small{font-size:9px;font-weight:800;color:#c9b48a;line-height:1.1;white-space:nowrap}.mults small.lock{color:#8a9aa6}
.mults .pips{display:flex;justify-content:center;gap:3px}.mults .pips i{width:9px;height:5px;border-radius:2px;background:#5b3a10}.mults .pips i.ok{background:#e0a11c}.mults .pips i.on{background:#ffd94a;box-shadow:0 0 5px #ffd94a}
.mults.off{opacity:.35;pointer-events:none}
.mults:focus-visible{outline:2px solid #fff}
.stat .over{color:#ffd94a}
.roll{width:180px;padding:7px 0 6px;border:0;border-radius:14px;color:#fff;font:inherit;font-weight:900;font-size:26px;letter-spacing:.04em;cursor:pointer;
  background:linear-gradient(180deg,#ffd94a 0%,#f2b632 45%,#d99a18 100%);box-shadow:0 5px 0 var(--gold-dark),0 8px 16px rgba(0,0,0,.5),inset 0 2px 0 rgba(255,255,255,.5);
  clip-path:polygon(6% 0,94% 0,100% 30%,100% 70%,94% 100%,6% 100%,0 70%,0 30%);text-shadow:0 2px 0 #9b6410}
.roll small{display:block;font-size:11px;font-weight:800;letter-spacing:0;color:#5b3a10;text-shadow:none;margin-top:-2px}
.roll:active{transform:translateY(3px)} .roll.busy{filter:saturate(.4) brightness(.8)}
.roll:focus-visible{outline:3px solid #fff;outline-offset:3px}
.rally{justify-self:start;border:0;border-radius:12px;padding:8px 10px;font:inherit;font-weight:900;font-size:13px;color:#2a1608;background:linear-gradient(180deg,#ffe38a,#e0a11c);box-shadow:0 3px 0 #7a4f06;cursor:pointer;min-width:74px}
.rally.live{background:linear-gradient(180deg,#ff9a4a,#e0561c);color:#fff;animation:pulse 1s infinite}
.rally:disabled{opacity:.5} .rally:focus-visible{outline:3px solid #fff}
.cheat{position:absolute;left:12px;top:18px;border:0;background:none;color:#e0c9a8;font:inherit;font-size:12px;text-decoration:underline;cursor:pointer}
@keyframes pulse{50%{transform:scale(1.05)}}
/* chat strip */
.chat{display:flex;align-items:center;gap:10px;padding:3px 12px;background:#0f1922;border-top:2px solid #2d3d48}
.chat .ico{width:30px;height:30px;border-radius:9px;background:#22343f;border:2px solid #56707f;flex:none;display:grid;place-items:center;font-size:13px;color:#cfe}
.chat .body{flex:1;min-width:0}
.chat .who{display:flex;justify-content:space-between;font-size:14px}.chat .who span{color:var(--muted);font-weight:700;font-size:12px}
.chat .msg{color:#e6d9b5;font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat .gift{width:34px;height:34px;flex:none}
/* nav */
nav{display:grid;grid-template-columns:repeat(5,1fr);background:#0a1015;padding:3px 4px calc(3px + env(safe-area-inset-bottom))}
nav button{background:none;border:0;color:#8a9aa6;font:inherit;font-size:10px;font-weight:900;letter-spacing:.06em;display:grid;justify-items:center;gap:2px;padding:4px 0;cursor:pointer;border-radius:8px}
nav button svg{width:22px;height:22px;fill:currentColor}
nav button.on{color:#fff} nav button:focus-visible{outline:2px solid #fff}
/* overlays */
.overlay{position:fixed;inset:0;background:rgba(6,12,18,.9);display:flex;align-items:center;justify-content:center;padding:24px;z-index:5}
.overlay[hidden]{display:none}
.panel{width:100%;max-width:380px;max-height:calc(100dvh - 40px);overflow-y:auto;overscroll-behavior:contain;background:#1b2a35;border:3px solid #3a5060;border-radius:18px;padding:22px 20px;box-shadow:0 20px 50px rgba(0,0,0,.6)}
.panel h1{font-size:34px;line-height:1;font-weight:900;color:var(--gold)}
.panel h2{font-size:30px;line-height:1.05;font-weight:900}
.panel p{margin:10px 0 14px;color:var(--muted);font-weight:700}
.panel .opts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}
.panel .opts button{padding:10px 4px;font:inherit;font-weight:900;font-size:15px;border-radius:10px;background:#0f1922;color:#fff;border:2px solid #3a5060;cursor:pointer}
.panel .opts button[aria-pressed="true"]{background:var(--gold);color:#2a1608;border-color:#ffd94a}
.panel button.go{width:100%;margin-top:4px;border:0;border-radius:12px;padding:12px;font:inherit;font-weight:900;font-size:20px;color:#2a1608;background:linear-gradient(180deg,#ffd94a,#e0a11c);box-shadow:0 4px 0 var(--gold-dark);cursor:pointer}
.panel table{width:100%;border-collapse:collapse;margin:10px 0 14px;font-size:15px;font-weight:700}
.panel td{padding:5px 0;border-bottom:1px solid #2d3d48;color:var(--muted)}
.panel td:last-child{text-align:right;font-variant-numeric:tabular-nums;color:#fff;font-weight:900}
.panel .win{color:var(--gold)} .panel .loss{color:var(--orange)}
.qte{background:#0d1a20;padding:0;z-index:20}
#qtec{width:100%;height:100%;display:block;touch-action:manipulation}
.qtetxt{position:absolute;top:max(18px,env(safe-area-inset-top));padding:0 18px;line-height:1.2;left:0;right:0;text-align:center;font-size:clamp(18px,5vw,26px);font-weight:900;color:#fff;text-shadow:0 2px 0 #000,0 0 18px rgba(255,217,74,.8);letter-spacing:.06em;pointer-events:none}
.panel.gift .friends{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.panel.gift .friends button{font:inherit;background:#0f1922;border:2px solid #3a5060;border-radius:12px;color:#fff;padding:10px 4px 8px;display:grid;justify-items:center;align-content:start;gap:4px;cursor:pointer}
.panel.gift .friends button[aria-pressed="true"]{border-color:#ffd94a;background:#1b2f3a}
.panel.gift .friends .face{width:44px;height:44px;border-radius:10px;background:#22485a;border:2px solid #37c0dd;display:grid;place-items:center;font-size:20px;font-weight:900}
.panel.gift .friends b{font-size:13px}.panel.gift .friends small{font-size:11px;color:var(--muted);font-weight:700}
.panel.gift .friends button{padding-bottom:0;overflow:hidden}.panel.gift .friends .gtag{width:calc(100% + 8px);margin:6px -4px 0;align-self:end;padding:7px 4px 8px;display:grid;gap:2px;background:linear-gradient(180deg,#4d8fd6,#2f64a8);border-top:4px solid #426378;box-shadow:inset 0 3px 0 rgba(255,255,255,.15)}
.panel.gift .friends .gtag b{font-size:12px;color:#fff;letter-spacing:.04em}.panel.gift .friends .gtag small{font-size:9.5px;color:#dfeaff;line-height:1.15}
.panel.gift .friends .gtag.gold{background:linear-gradient(180deg,#54778d,#304a5d)}
.panel.gift .friends button.gift-bonus{border-color:#ffd94a;box-shadow:0 0 14px #ffd94a33}
.panel.gift .friends button.gift-bonus .gtag{background:linear-gradient(180deg,#d6a52f,#9b6410);border-top-color:#ffe782}
.panel.gift .friends .bonus-label{color:#fff1b8;font-size:10px;font-weight:900}.panel.gift .friends .gtag.attack{background:linear-gradient(180deg,#d65a3a,#9b2f1a)}
.panel.gift .gifts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.panel.gift .gifts[hidden]{display:none}
.panel.gift .gifts button{font:inherit;background:linear-gradient(180deg,#4d8fd6,#2f64a8);border:0;border-top:6px solid #ffd94a;border-radius:10px;color:#fff;padding:12px 4px 10px;display:grid;gap:3px;cursor:pointer;box-shadow:0 4px 0 #1d3f6b}
.panel.gift .gifts button:disabled{opacity:.4}
.panel.gift .gifts b{font-size:14px}.panel.gift .gifts small{font-size:10px;font-weight:700;opacity:.9}
.panel.light{background:#f4f4f2;color:#1b2a35;border-color:#fff}
.panel.light h2{font-size:24px;text-align:center}.panel.light p{color:#2d3d48;text-align:center;font-weight:800;font-size:15px}.panel.light .blue{color:#2aa0d8}.panel.light .gold{color:#b8860b}.panel.light .orange{color:#d9601e}.panel.light p{text-align:left;font-size:14px}
.panel button.go.green{background:linear-gradient(180deg,#8ee04c,#4faa24);color:#fff;box-shadow:0 4px 0 #2e6e12;text-shadow:0 1px 0 #2e6e12;width:60%;margin:4px auto 0;display:block}

/* war map */
.warmap{position:relative;flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;background:#245a68;-webkit-overflow-scrolling:touch}
#warcv{display:block;width:100%;height:auto;touch-action:pan-y}
.warhead{position:sticky;top:0;z-index:3;display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:8px;padding:6px 10px;background:linear-gradient(180deg,rgba(8,14,20,.97),rgba(8,14,20,.9));border-bottom:2px solid #0a1015;box-shadow:0 6px 16px rgba(0,0,0,.45)}
.warhead .wsc{display:grid;justify-items:center;min-width:46px;padding:3px 4px;border-radius:10px;border:2px solid #37c0dd;background:rgba(55,192,221,.12)}
.warhead .wsc.them{border-color:#e8702f;background:rgba(232,112,47,.12)}
.warhead .wsc b{font-size:17px;line-height:1;color:#fff;text-shadow:0 1px 0 #000}.warhead .wsc small{font-size:9px;letter-spacing:.1em;font-weight:900;color:#37c0dd}.warhead .wsc.them small{color:#e8702f}
.warhead .wsc.lead b{color:#ffd94a}
.whex{display:flex;justify-content:center;align-items:center;gap:2px;flex-wrap:nowrap;min-width:0}
.whex button{position:relative;flex:0 0 auto;width:22px;height:25px;padding:0;border:0;background:none;font:inherit;font-weight:900;font-size:9px;color:#fff;cursor:pointer;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
.whex button i{position:absolute;inset:2px;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);background:#5b3a10;display:grid;place-items:center;font-style:normal}
.whex button.us i{background:#1f5f8a}.whex button.them i{background:#a12a24}.whex button{background:#0a1015}
.whex button.here{background:#7ee04c;animation:hereBlink 1.4s ease-in-out infinite}.whex button.clear i{background:#2b6b1e}
.whex button.pts3{width:26px;height:29px;font-size:10px}
@keyframes hereBlink{50%{filter:brightness(1.35)}}
.mapbottom{padding:10px 14px 18px;text-align:center;color:#9fc3d3;font-size:12px;font-weight:800;line-height:1.35}
.whelp{width:26px;height:26px;border-radius:50%;border:2px solid #ffd94a;background:#0a1015;color:#ffd94a;font:inherit;font-weight:900;font-size:14px;cursor:pointer;padding:0}
.tbar .st{width:100%;font-size:11px;line-height:1.2;font-weight:800;color:#9fc3d3;padding:0 2px 3px}.tbar .st b{color:#fff}.tbar .st.us{color:#37c0dd}.tbar .st.them{color:#e8702f}.tbar .st.siege{color:#ffd94a}
.bossbtn{position:sticky;top:50px;z-index:2;width:calc(100% - 20px);margin:6px 10px -58px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:6px 10px;border:2px solid #c9302f;border-radius:14px;background:linear-gradient(180deg,rgba(60,10,14,.95),rgba(20,6,8,.95));color:#fff;font:inherit;font-weight:900;text-align:left;cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,.5)}
.mapbg{position:absolute;inset:0;background-size:cover;background-position:center 30%}
.mapbg::after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%,rgba(0,0,0,0) 45%,rgba(0,0,0,.45) 100%)}
.mapHint{position:absolute;left:0;right:0;bottom:6px;text-align:center;font-size:12px;color:#fff;text-shadow:0 1px 2px #000;opacity:.8;pointer-events:none}
