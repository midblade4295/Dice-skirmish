/* war summary */
.sumhead{display:grid;grid-template-columns:56px 1fr 56px;align-items:center;gap:6px;text-align:center}
.sumhead small{display:block;font-size:10px;color:var(--muted);letter-spacing:.1em}.sumhead b{display:block;font-size:34px;line-height:1;margin:2px 0}.sumhead h2{font-size:22px}
.flag{height:64px;border-radius:0 0 10px 10px;position:relative;clip-path:polygon(0 0,100% 0,100% 100%,50% 84%,0 100%);display:grid;place-items:end center;padding-bottom:12px;font-size:8px;font-weight:900;color:#fff;text-shadow:0 1px 2px #000}
.flag.l{background:linear-gradient(180deg,#37c0dd,#1d5f6e)}.flag.r{background:linear-gradient(180deg,#c9302f,#6a1a1a)}.flag::before{content:"";position:absolute;left:0;right:0;top:0;height:5px;background:#ffd94a}
.sumh{text-align:center;font-size:12px;letter-spacing:.12em;color:#e6d9b5;margin:10px 0 4px}
.honor{display:grid;grid-template-columns:104px 1fr;gap:8px;align-items:center;background:linear-gradient(180deg,#14262f,#0f1922);border:2px solid #3a5060;border-radius:14px;padding:8px;margin:6px 0}
.honor canvas{width:104px;height:104px;background:radial-gradient(ellipse at 50% 88%,rgba(255,217,74,.35),transparent 60%);border-radius:10px}
.honor .t{text-align:center}.honor .t b{display:block;font-size:17px}.honor .t small{display:block;font-size:10px;color:var(--gold);letter-spacing:.08em;font-weight:900}
.honor .t .big{font-size:24px;color:#fff;margin:4px 0 2px}.honor .t .you{font-size:12px;color:#ffd94a;font-weight:800}.honor .t .you i{font-style:normal;color:#fff}
.honor .nm{font-size:12px;color:#fff;font-weight:900;text-align:center;margin-top:-6px}
.rewards{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:4px 0 10px}
.rewards div{background:#0f1922;border:2px solid #3a5060;border-radius:12px;padding:8px 4px;text-align:center}.rewards div i{display:block;font-style:normal;font-size:24px}.rewards div b{display:block;font-size:15px;color:#fff}.rewards div small{font-size:10px;color:var(--muted);font-weight:800}
.endmore{margin-top:8px}.endmore summary{cursor:pointer;color:var(--muted);font-size:13px;font-weight:800;text-align:center;padding:6px}
/* daily boss */
.bossbtn .skull{font-size:22px}.bossbtn small{display:block;color:#ffb0a0;font-size:10.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bossbtn>span:nth-child(2){min-width:0;font-size:13px}.bossbtn .hpb{height:6px;background:#0a1015;border-radius:3px;margin-top:4px;overflow:hidden}.bossbtn .hpb i{display:block;height:100%;background:linear-gradient(90deg,#ff5a3a,#c9302f)}
.bossbtn .go{background:#ff5a3a;color:#fff;font-size:12px;padding:6px 10px;border-radius:9px;white-space:nowrap}.bossbtn.dead{border-color:#7ee04c}.bossbtn.dead .go{background:#2e6e12}
.panel.boss{border-color:#c9302f;max-height:calc(100dvh - 30px)}
.panel.boss h2{color:#ff5a3a}.panel.boss .bossart{display:grid;place-items:center;height:150px;background:radial-gradient(ellipse at 50% 85%,rgba(201,48,47,.45),transparent 65%);border-radius:14px}
.panel.boss .hpbar{height:16px;background:#0a1015;border-radius:8px;border:2px solid #3a5060;overflow:hidden;position:relative}.panel.boss .hpbar i{display:block;height:100%;background:linear-gradient(90deg,#ff5a3a,#c9302f)}.panel.boss .hpbar span{position:absolute;inset:0;text-align:center;font-size:11px;line-height:12px;color:#fff;text-shadow:0 1px 2px #000}
.panel.boss .mech{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:8px 0;font-size:12px}.panel.boss .mech div{background:#0f1922;border-radius:10px;padding:7px 9px}.panel.boss .mech b{color:#ffd94a;display:block;font-size:12px}.panel.boss .mech small{color:var(--muted);font-weight:700;font-size:11px}
.panel.boss .tiers{margin:6px 0}.panel.boss .tier{padding:6px 10px}.panel.boss .tier b{font-size:13px}
.panel.boss .btns{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:8px}.panel.boss button.go{margin:0}.panel.boss button.go.red{background:linear-gradient(180deg,#ff7a5a,#c9302f);color:#fff;box-shadow:0 4px 0 #7a1f1e;text-shadow:0 1px 0 #7a1f1e}.panel.boss button.go:disabled{filter:saturate(.3) brightness(.7)}
.panel.boss .clan{display:grid;gap:3px;font-size:12px;font-weight:700}.panel.boss .clan div{display:grid;grid-template-columns:22px 1fr auto;gap:6px;padding:3px 8px;border-radius:7px;background:#0f1922;color:var(--muted)}.panel.boss .clan div.me{background:#3a1a1c;color:#fff;outline:2px solid #ff5a3a}
.tokens{display:inline-block;background:#3a1a1c;border:1.5px solid #ff5a3a;color:#ffb0a0;border-radius:8px;padding:2px 8px;font-size:12px;font-weight:900}
.tbar.boss{background:#2a0c10;border-bottom-color:#c9302f}.tbar.boss .bar i{background:#ff5a3a}.tbar.boss .bar{background:#3a1a1c}
.parry{position:fixed;left:50%;top:44%;transform:translate(-50%,-50%);z-index:6;pointer-events:none;text-align:center;font-size:26px;font-weight:900;color:#ff5a3a;text-shadow:0 3px 0 #000,0 0 22px rgba(255,90,58,.9);letter-spacing:.06em;opacity:0;transition:opacity .1s}
.parry.show{opacity:1;animation:pulse .3s infinite}.parry small{display:block;font-size:13px;color:#fff}
@media (prefers-reduced-motion: reduce){ .score .track i{transition:none} .toast{transition:none} .rally.live{animation:none} }

